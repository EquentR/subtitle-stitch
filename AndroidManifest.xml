<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.subtitlestitch">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- Read screenshots from MediaStore (API 33+ granular media perms) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Floating bubble -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service keeps the screenshot watcher alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required on Android 14+ to hold a MediaProjection capture session.
         Consent itself is granted by the system dialog, not by this permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Query the system screenshot app so we can show its icon/label -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:name=".StitchApp"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StitchActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Invisible trampoline: lets the floating bubble request capture
             consent without the user opening the app manually. -->
        <activity
            android:name=".ConsentProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".ShotWatcherService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

        <service
            android:name=".BubbleService"
            android:exported="false" />

        <!-- Quick-settings tile: start/stop the watcher from the control centre -->
        <service
            android:name=".WatchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="字幕拼接"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
