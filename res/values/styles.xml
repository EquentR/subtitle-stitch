<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Home theme. `values-night/styles.xml` overrides AppTheme with the dark
        parent, so the app follows the system light/dark setting automatically.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFF5F6F8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowBackground">#FFF5F6F8</item>
    </style>

    <!-- Dark variant of the home theme. -->
    <style name="AppTheme_Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF111316</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#FF111316</item>
        <item name="android:windowBackground">#FF111316</item>
    </style>

    <!-- The stitch editor is intentionally dark; it shows images, not UI chrome. -->
    <style name="DarkTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorPrimary">#FF1F6FEB</item>
        <item name="android:colorAccent">#FF1F6FEB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF1A1F26</item>
        <item name="android:navigationBarColor">#FF111418</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
