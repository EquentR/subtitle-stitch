<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF1F6FEB</item>
        <item name="android:colorAccent">#FF1F6FEB</item>
        <!-- Light UI (near-white background): use a light status bar with DARK
             icons/text, otherwise the system's white glyphs vanish on white. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFF5F6F8</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The stitch editor is a dark screen; it needs light (white) glyphs. -->
    <style name="DarkTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FF1F6FEB</item>
        <item name="android:colorAccent">#FF1F6FEB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#FF1A1F26</item>
        <item name="android:navigationBarColor">#FF111418</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
