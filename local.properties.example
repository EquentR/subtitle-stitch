# Copy this file to local.properties and fill in your own paths.
# local.properties is git-ignored so machine-specific values (and any signing
# password) stay out of the repository.

# Android SDK root (must contain platforms/android-36 and build-tools/36.0.0)
sdk.dir=C:/Users/you/AppData/Local/Android/Sdk

# JDK 17 or newer
java.home=C:/Program Files/Java/jdk-21

# Optional: release signing. Omit to build with an auto-generated debug key.
# apksigner requires a PKCS#12 keystore (it cannot read a PEM private key).
#keystore.path=C:/keys/release.p12
#keystore.pass=yourpassword
#keystore.alias=release
